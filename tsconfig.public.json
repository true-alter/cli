{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "stripInternal": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/commands/attribution-log.ts",
    "src/commands/prose-signoff.ts",
    "src/lib/weave-log.ts"
  ]
}
