# Normalise line endings: store LF in the repo, choose on checkout per type.
* text=auto

# Shell scripts must be LF in the working tree on every platform.
# A CRLF shebang (e.g. `#!/usr/bin/env bash\r`) yields `bad interpreter`
# on Unix, so these are pinned to LF even when checked out on Windows.
*.sh text eol=lf


# Source + build scripts are cross-platform text that must never carry CR:
# *.mjs/*.cjs/*.js build + test scripts ship a `#!/usr/bin/env node` shebang,
# and TS/JS/JSON/Markdown are LF everywhere by convention. Pinning forecloses
# any CR creeping in via a Windows checkout.
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows-native scripts stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Vendored dependencies: leave bytes exactly as published, never normalise.
# Listed AFTER the per-extension rules above so this exclusion wins for files
# inside node_modules (gitattributes resolves later-listed patterns last);
# e.g. a node_modules/**/*.md keeps its published CRLF, not the *.md eol=lf rule.
node_modules/** -text

# Vendored embedded plugins are byte-pinned to a published commit and verified
# against embedded-plugins.lock.json at build time. They must check out
# byte-for-byte identical on every platform, so they are never normalised: a
# Windows checkout (autocrlf=true) would otherwise convert styles.css (and any
# other non-LF-pinned extension) to CRLF, changing its bytes and breaking the
# lock hash. Listed after the per-extension rules above so this exclusion wins.
vendor/embedded-plugins/** -text

# Binary assets: never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

